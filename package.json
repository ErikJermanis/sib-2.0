{
  "name": "sib-2.0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n client,server -c cyan,green \"vite --host\" \"node --env-file-if-exists=.env --import tsx --watch src/server/index.ts\"",
    "build": "npm run clean && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "clean": "rm -rf dist coverage",
    "start": "node --env-file-if-exists=.env dist/server/server/index.js",
    "typecheck": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "app": "node --env-file-if-exists=.env --import tsx src/server/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
